      {
        "selector": "JSXOpeningElement[name.name='ConfirmModal'] > JSXAttribute > JSXIdentifier[name!=/^(?:kind|title|message|confirmLabel|cancelLabel|onConfirm|onCancel|children|style|key|ref|className|style|children)$/]",
